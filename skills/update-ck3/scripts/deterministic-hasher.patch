+/// Builds ahash hashers with fixed seeds, so that hash map iteration order (and thus the order
+/// in which items are validated) is the same on every run.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct TigerBuildHasher;
+
+impl BuildHasher for TigerBuildHasher {
+    type Hasher = AHasher;
+    fn build_hasher(&self) -> AHasher {
+        RandomState::with_seeds(1, 2, 3, 4).build_hasher()
+    }
+}
+
+pub type TigerHashMap<K, V> = HashMap<K, V, TigerBuildHasher>;
 pub use ahash::HashMapExt as TigerHashMapExt;
